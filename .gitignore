## Flutter / Dart gitignore

# Dart
.dart_tool/
.packages
build/
# pubspec.lock: Flutter uygulamaları için commit edilir (kütüphaneler için ignore edilir)

# Flutter
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
.metadata

# Android
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/*.keystore
**/*.jks
**/*.aab

# iOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/.generated/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/*.ipa
**/*.p8
**/*.p12
**/*.mobileprovision

# Private keys / machine credentials / signing inputs
**/*.pem
**/*.key
**/AuthKey_*.p8
**/*service-account*.json
**/*service_account*.json
**/dart-define*.json
**/dart_defines*.json

# macOS
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/

# Coverage
coverage/
lcov.info
!test/coverage/
!test/coverage/*.dart

# Code review artefactları (lokal incelemeler)
docs/code-reviews/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# Secrets & Environment
.env
.env.*
!.env.example
.saydin/local/

# Claude Code transient scheduled-task lock
.claude/scheduled_tasks.lock
