<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction Rules — Android 12+ (API 31+).

  İki ayrı senaryo için politika:
   1. `cloud-backup`: kullanıcı Google hesabıyla auto-backup → DISABLE.
   2. `device-transfer`: kullanıcı yeni cihaza geçiş yardımcısı → DISABLE.

  Saydın'da finansal "ya alsaydım" hesaplamaları, asset arama geçmişi,
  ve device ID kullanıcı kimliğine bağlanabilir. KVKK Madde 11/12 ve
  GDPR Madde 17 (right to be forgotten) gereği: silinen veri sonradan
  cloud backup'tan geri gelmemelidir.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
