<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network güvenlik politikası.

  cleartextTrafficPermitted="false": tüm HTTP istekleri (TLS olmadan)
  reddedilir. Bu, kullanıcının arada bir proxy/captive portal HTTP yanıtı
  enjekte etmesini ve MITM saldırılarını engeller. KVKK Madde 12 ile App
  Store / Play Store iletim güvenliği yönergelerinin gereği.

  Debug variant cleartext'i daha dar kapsamla (sadece localhost + dev
  tünelleri) `android/app/src/debug/res/xml/network_security_config.xml`
  içinde aktive eder; release build'lerde debug overlay derlenmez.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
