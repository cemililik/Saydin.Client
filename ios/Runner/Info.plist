<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Saydın</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- Desteklenen diller (F-03-17): App Store dil rozeti + iOS dil seçimi
	     için tr ve en açıkça listelenir. Flutter AppLocalizations ile uyumlu. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
		<string>en</string>
	</array>
	<key>CFBundleName</key>
	<string>Saydın</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!--
	  Export compliance — Saydın yalnızca Apple'ın standart şifreleme
	  yüzeyini kullanır (URLSession HTTPS, keychain, file data protection).
	  Bunların tamamı ihracat istisnası kapsamındadır. Bu anahtar `false`
	  olarak ayarlandığında App Store Connect her TestFlight yüklemesini
	  otomatik olarak "export exempt" işaretler ve maintainer'ın "Missing
	  Compliance" diyaloğundan geçmesi gerekmez. İleride özel kripto kodu
	  eklenirse `true` yapılmalı ve şu rehber takip edilmeli:
	  https://developer.apple.com/documentation/security/complying_with_encryption_export_regulations
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
	  Release ve Profile App Transport Security (ATS) politikası.

	  Bu dosya yalnızca TLS trafiğine izin verir; local networking ve HTTP
	  exception anahtarları kasıtlı olarak YOKTUR. Debug için gerekli localhost
	  istisnası ayrı `Info-Debug.plist` içindedir. Böylece native/plugin
	  URLSession çağrıları da release artifact'te cleartext kullanamaz.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<false/>
	</dict>
	<!--
	  ITMS-90683 için zorunlu. share_plus eklentisi iOS'ta "Fotoğraflara
	  Kaydet" paylaşım sayfası seçeneği için PhotoKit framework'üne bağlanır.
	  Saydın doğrudan fotoğraf kütüphanesini sorgulamaz, ancak kullanıcı
	  hesaplama sonucu kartını paylaşıp sistem "Fotoğraflara Kaydet"
	  eylemini seçtiğinde iOS bu açıklamayı izin penceresinde gösterir.

	  `NSPhotoLibraryAddUsageDescription` kullanıyoruz (read+write değil
	  add-only). Saydın fotoğraf okuma izni istemiyor — sadece kaydetme.
	  Apple App Store review minimum izin prensibini bu add-only varyantla
	  doğrular (F-14-13).
	-->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Hesaplama sonucu kartını Fotoğraflar uygulamasına kaydetmek istediğinizde fotoğraf kütüphanenize yazma izni gerekir.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
